{
  "opencollection": "1.0.0",
  "info": {
    "name": "Make AI Agents Scenarios API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Scenarios",
        "type": "folder"
      },
      "items": [
