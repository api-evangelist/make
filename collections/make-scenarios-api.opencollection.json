              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update scenario"
        },
        {
          "info": {
            "name": "Delete scenario",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://us1.make.com/api/v2/scenarios/:scenarioId",
            "params": [
              {
                "name": "scenarioId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete scenario"
        },
        {
          "info": {
            "name": "Get trigger details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us1.make.com/api/v2/scenarios/:scenarioId/triggers",
